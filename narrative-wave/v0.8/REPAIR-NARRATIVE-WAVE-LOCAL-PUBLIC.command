#!/usr/bin/env bash
# Narrative Wave v0.8 - repairs local standalone search + public Firebase/Cloudflare gateway.
# One verified archive, no assumptions about the Downloads directory.
set -euo pipefail
PROJECT='narrative-wave-tgot-b64ad8'
ACCOUNT='tim@pyrinas.co'
APP="$HOME/Applications/Narrative-Wave"
PUBLIC="$APP/public-web"
ROOT="${NARRATIVE_WAVE_REPAIR_ROOT:-$APP}"
MODE="${1:-deploy}"
if [[ "$MODE" != deploy && "$MODE" != --local-only && "$MODE" != --dry-run ]];then
  echo 'Usage: bash updater.command [--local-only|--dry-run]' >&2;exit 2
fi
TMP="$(mktemp -d "${TMPDIR:-/tmp}/nw-search-repair-v08.XXXXXXXX")"
cleanup(){ /bin/rm -rf "$TMP"; }
trap cleanup EXIT
if ! command -v python3 >/dev/null 2>&1;then echo 'ERROR: Python 3 required.' >&2;exit 1;fi
