expected='f06bb68a951cc945fa359e442bc7011c90c3cc098bd20437822e5014d3d45335'
compressed=base64.b64decode(''.join(payload.split()),validate=True)
if hashlib.sha256(compressed).hexdigest()!=expected:
    raise SystemExit('ERROR: Release checksum failed. Nothing changed.')
out=Path(sys.argv[1]); allowed={'local/nw_live_search.py', 'local/widget.html', 'local/widget.js', 'site/README-BACKEND.md', 'site/favicon.svg', 'site/index.html', 'site/legal.html', 'site/pyrinas-wordmark.svg', 'site/spark.css', 'site/spark.js', 'worker/package.json', 'worker/test/worker.test.mjs', 'worker/worker.js', 'worker/wrangler.jsonc', 'tests/test_local_live_search.py', 'README-REPAIR.md'}
with tarfile.open(fileobj=io.BytesIO(gzip.decompress(compressed)),mode='r:') as tar:
    members=tar.getmembers()
    if {x.name for x in members}!=allowed or not all(x.isfile() and 0<x.size<270000 for x in members):
        raise SystemExit('ERROR: Unexpected archive files. Nothing changed.')
    for item in members:
        target=out/item.name;target.parent.mkdir(parents=True,exist_ok=True)
        target.write_bytes(tar.extractfile(item).read())
print('Narrative Wave 0.8 verified payload extracted.')
NW_UNPACK
printf '\nRunning local search tests...\n'
(cd "$TMP" && python3 -m unittest discover -s tests -q)
if command -v node >/dev/null 2>&1;then
  printf '\nRunning news gateway tests...\n'
  (cd "$TMP/worker" && node --test | tail -n 12)
  node --check "$TMP/site/spark.js"
fi
if [[ "$MODE" == '--dry-run' ]];then
  echo 'DRY RUN COMPLETE. Verified release and tests; no app or account modified.'
  exit 0
fi

# ----- LOCAL REPAIR -----
LOCAL_APP="$ROOT/standalone/app.py"
LOCAL_PAGE="$ROOT/standalone/index.html"
if [[ ! -f "$LOCAL_APP" || ! -f "$LOCAL_PAGE" ]];then
  echo "ERROR: Expected standalone installation not found at $ROOT/standalone. No files updated." >&2
  exit 1
fi
BACKUP="$ROOT/data/nw-search-repair-backups/$(date '+%Y%m%d-%H%M%S')"
mkdir -p "$BACKUP"
cp "$LOCAL_APP" "$BACKUP/app.py"
cp "$LOCAL_PAGE" "$BACKUP/index.html"
python3 - "$LOCAL_APP" "$LOCAL_PAGE" "$TMP/local" <<'NW_INSTALL_LOCAL'
from pathlib import Path
import sys
app,page,assets=map(Path,sys.argv[1:])
original=app.read_text()
insert_at="if __name__ == '__main__': serve()"
hook="\n# Narrative Wave v0.8 live, on-demand research endpoints\nimport nw_live_search as _nw_live_search\n_nw_live_search.install(sys.modules[__name__])\n\n"
if 'class Handler(BaseHTTPRequestHandler)' not in original or insert_at not in original:
    raise SystemExit('ERROR: Local source does not match the verified v0.2 standalone app. No changes made.')
html=page.read_text()
search_marker='<section class="card"><div class="row"><h2>Live news industry radar</h2>'
if 'nw-new-research' not in html and search_marker not in html:
    raise SystemExit('ERROR: Local dashboard structure not recognized. No changes made.')
if 'nw_live_search.install' not in original:
    app.write_text(original.replace(insert_at,hook+insert_at))
if 'nw-new-research' not in html:
    html=html.replace(search_marker,(assets/'widget.html').read_text()+ '\n'+search_marker)
    html=html.replace('</body>', '<script>\n'+(assets/'widget.js').read_text()+'\n</script></body>')
    page.write_text(html)
(app.parent/'nw_live_search.py').write_bytes((assets/'nw_live_search.py').read_bytes())
print('On-demand search endpoints + local research interface installed.')
NW_INSTALL_LOCAL
if ! python3 -m py_compile "$LOCAL_APP" "$ROOT/standalone/nw_live_search.py";then
  cp "$BACKUP/app.py" "$LOCAL_APP";cp "$BACKUP/index.html" "$LOCAL_PAGE"
  echo 'ERROR: Local Python validation failed. Reverted app and HTML.' >&2;exit 2
fi

# Restart ONLY this particular standalone Python server, never other users' services.
if [[ "$ROOT" == "$APP" ]];then
  if command -v lsof >/dev/null 2>&1 && command -v curl >/dev/null 2>&1;then
    for port in $(seq 8877 8899);do
      health="$(curl -fsS --max-time 1 "http://127.0.0.1:$port/api/health" 2>/dev/null || true)"
      if [[ "$health" == *'0.2-one-paste'* ]];then
        for pid in $(lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true);do
          commandline="$(ps -p "$pid" -o command= 2>/dev/null || true)"
          if [[ "$commandline" == *"$APP/standalone/app.py"* ]];then
            echo "Restarting Narrative Wave local service on port $port (PID $pid)."
            kill "$pid" 2>/dev/null || true
          fi
        done
      fi
    done
  fi
  sleep 1
  nohup /bin/bash "$APP/START-NARRATIVE-WAVE.command" > "$APP/data/nw-live-search-v08.log" 2>&1 </dev/null &
  LOCAL_CHECK=0
  for n in $(seq 1 16);do
    sleep 1
    for port in $(seq 8877 8899);do
      if curl -fsS --max-time 1 "http://127.0.0.1:$port/api/live-search?q=x" 2>/dev/null | grep -q 'invalid_query';then
        echo "LOCAL SEARCH API READY: http://127.0.0.1:$port"
        LOCAL_CHECK=1;LOCAL_PORT="$port";break
      fi
    done
    [[ "$LOCAL_CHECK" == 1 ]] && break
  done
  if [[ "$LOCAL_CHECK" != 1 ]];then
    echo 'WARNING: Local source patched, but the running server was not verified. Check local log in Narrative-Wave/data/nw-live-search-v08.log.' >&2
  else
    if command -v open >/dev/null 2>&1;then open "http://127.0.0.1:$LOCAL_PORT/?nw=080" >/dev/null 2>&1 || true;fi
    printf 'Probing real local Detroit news coverage (maximum 48 seconds)...\n'
    curl -sS --max-time 48 "http://127.0.0.1:$LOCAL_PORT/api/live-search?q=Detroit&range=30d" | python3 -c 'import json,sys;d=json.load(sys.stdin);print("LOCAL PROVIDER STATUS:",d.get("status"),"| real indexed records:",len(d.get("articles",[])));print("Provider notes:"," | ".join(d.get("warnings",[])[:3]))' || true
  fi
fi
printf 'LOCAL REPAIR COMPLETE. Existing research database preserved. Backup: %s\n' "$BACKUP"
if [[ "$MODE" == '--local-only' ]];then
  echo 'Local-only mode complete. Public Firebase site was not changed.'
  exit 0
fi

# ----- PUBLIC REPAIR: IF WORKER DEPLOY/COVERAGE FAILS, LEAVE FIREBASE UNTOUCHED -----
PUBLIC_CHECK="$PUBLIC/.nw-project-id"
if [[ ! -f "$PUBLIC_CHECK" || "$(tr -d '\r\n' < "$PUBLIC_CHECK")" != "$PROJECT" ]];then
  echo 'ERROR: Dedicated Firebase project is not confirmed. Local repaired; public site unchanged.' >&2;exit 4
fi
if [[ ! -f "$PUBLIC/firebase.spark.json" || ! -f "$PUBLIC/public/index.html" ]];then
  echo 'ERROR: Existing Spark Hosting config was not found. Public site unchanged.' >&2;exit 4
fi
if ! python3 - "$PUBLIC/firebase.spark.json" "$PROJECT" <<'NW_VERIFY_SITE'
import sys,json
try:
 d=json.load(open(sys.argv[1]));h=d['hosting'];assert h['site']==sys.argv[2] and h['public']=='public'
except Exception as exc:print('Unexpected Firebase Hosting target:',exc,file=sys.stderr);sys.exit(1)
NW_VERIFY_SITE
then exit 4;fi
if [[ ! -t 0 ]];then
  echo 'ERROR: Public deployment requires interactive Terminal for account login; local repair is complete.' >&2;exit 4
fi
if [[ "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" != 22 && "$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)" != 24 ]];then
  if command -v brew >/dev/null 2>&1;then
    prefix="$(brew --prefix node@22 2>/dev/null || true)"
    [[ -x "$prefix/bin/node" ]] && export PATH="$prefix/bin:$PATH"
  fi
fi
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "$NODE_MAJOR" != 22 && "$NODE_MAJOR" != 24 ]];then
  echo 'ERROR: Public deploy requires existing Node 22/24. Local repair complete.' >&2;exit 4
fi
FB="$PUBLIC/.tools/node_modules/.bin/firebase"
if [[ ! -x "$FB" ]];then echo 'ERROR: Existing private Firebase CLI not found. Public site unchanged.' >&2;exit 4;fi
if ! "$FB" login:list 2>&1 | grep -Fq "$ACCOUNT";then
  echo "ERROR: Firebase CLI must be authenticated as $ACCOUNT. Public site unchanged." >&2;exit 4
fi
TOOLS_DIR="$PUBLIC/.nw-news-tools"
mkdir -p "$TOOLS_DIR"
WRANGLER="$TOOLS_DIR/node_modules/.bin/wrangler"
if [[ ! -x "$WRANGLER" ]];then
  echo 'Setting up Wrangler inside Narrative Wave; no global installation.'
  npm install --no-audit --no-fund --prefix "$TOOLS_DIR" 'wrangler@^4.119.0'
fi
if ! "$WRANGLER" whoami >/dev/null 2>&1;then
  printf '\nCloudflare Worker login required. Authorize the browser/device code shown by Wrangler.\n'
  "$WRANGLER" login --device </dev/tty
fi
if ! "$WRANGLER" whoami >/dev/null 2>&1;then
  echo 'ERROR: Cloudflare authentication failed. Public site unchanged.' >&2;exit 4
fi
WORKER_DIR="$PUBLIC/.nw-news-gateway-v08"
if [[ -e "$WORKER_DIR" && ! -f "$WORKER_DIR/.nw-worker-v08" ]];then
  echo 'ERROR: Unrecognized Worker directory; public site unchanged.' >&2;exit 4
fi
mkdir -p "$WORKER_DIR"
cp -R "$TMP/worker/." "$WORKER_DIR/"
printf 'NW_NEWS_WORKER_08\n' > "$WORKER_DIR/.nw-worker-v08"
printf '\nDeploying updated Cloudflare news backend...\n'
(cd "$WORKER_DIR" && "$WRANGLER" deploy --config "$WORKER_DIR/wrangler.jsonc" </dev/tty) 2>&1 | tee "$TMP/wrangler.log"
WORKER_URL="$(python3 - "$TMP/wrangler.log" <<'NW_WORKER_URL'
import re,sys
s=open(sys.argv[1]).read();u=re.findall(r'https://narrative-wave-news-tgot\.[a-z0-9.-]+\.workers\.dev',s,re.I)
print(u[-1].rstrip('/') if u else '')
NW_WORKER_URL
)"
if [[ ! "$WORKER_URL" =~ ^https://narrative-wave-news-tgot\.[a-z0-9.-]+\.workers\.dev$ ]];then
  echo 'ERROR: Worker URL not confirmed. Public Firebase site unchanged.' >&2;exit 5
fi
printf 'Cloudflare Worker URL: %s\n' "$WORKER_URL"
if ! curl -fsSL --max-time 20 -H "Origin: https://$PROJECT.web.app" "$WORKER_URL/health" | python3 -c 'import json,sys; j=json.load(sys.stdin); assert j.get("status")=="ok" and j.get("service")=="narrative-wave-news-gateway"';then
  echo 'ERROR: Live Worker health validation failed. Public Firebase site unchanged.' >&2;exit 5
fi
LIVE_OK=0
for QUERY in Detroit;do
  printf 'Checking real public news retrieval for: %s\n' "$QUERY"
  if curl -fsSLG --max-time 90 -H "Origin: https://$PROJECT.web.app" \
    --data-urlencode "q=$QUERY" --data-urlencode 'range=30d' "$WORKER_URL/news" -o "$TMP/live.json";then
    if python3 - "$TMP/live.json" <<'NW_REAL_NEWS'
import json,sys
j=json.load(open(sys.argv[1]));a=j.get('articles',[])
print('REAL WORKER STATUS:',j.get('status'),'| source:',j.get('provider'),'| records:',len(a))
if not a: print('Diagnostics:', ' | '.join(j.get('warnings',[])[:4]))
assert j.get('status')=='ok' and any(x.get('url','').startswith('https://') for x in a)
assert any(n in str(j.get('provider','')) for n in ['Bing News RSS','Google News RSS','GDELT DOC']), 'Tech-community links alone do not verify general news retrieval'
NW_REAL_NEWS
    then LIVE_OK=1;break;fi
  fi
done
if [[ "$LIVE_OK" != 1 ]];then
  echo 'ERROR: Live Worker retrieved no real news. Public site NOT replaced. Local repair remains installed.' >&2
  exit 5
fi

# Public site installation only happens after real Worker is verified.
SITEBACK="$PUBLIC/.nw-site-backups/$(date '+%Y%m%d-%H%M%S')-v08"
mkdir -p "$SITEBACK";cp -R "$PUBLIC/public" "$SITEBACK/public"
rollback(){
  code=$?
  if [[ "$code" -ne 0 && -f "$SITEBACK/public/index.html" ]];then
    /bin/rm -rf "$PUBLIC/public";cp -R "$SITEBACK/public" "$PUBLIC/public"
    echo 'Public site local files restored after deployment failure.' >&2
  fi
  cleanup
}
trap rollback EXIT
for f in index.html spark.js spark.css legal.html favicon.svg pyrinas-wordmark.svg;do
  cp "$TMP/site/$f" "$PUBLIC/public/$f"
done
python3 - "$PUBLIC/public/worker-config.js" "$WORKER_URL" <<'NW_CONFIG'
import json,sys
open(sys.argv[1],'w').write('/* Narrative Wave public gateway; no secret credentials. */\nwindow.NARRATIVE_WAVE_NEWS_API='+json.dumps(sys.argv[2])+';\n')
NW_CONFIG
node --check "$PUBLIC/public/spark.js"
(cd "$PUBLIC" && "$FB" --account "$ACCOUNT" deploy --only hosting --config firebase.spark.json --project "$PROJECT" --non-interactive)
trap cleanup EXIT
SITE="https://$PROJECT.web.app"
printf '\nNARRATIVE WAVE v0.8 PUBLIC REPAIR DEPLOYED\n%s\nBackend: %s\nPrevious site backup: %s\n' "$SITE" "$WORKER_URL" "$SITEBACK"
if curl -fsSL --max-time 20 "$SITE/worker-config.js?v=080" | grep -Fq "$WORKER_URL";then
  echo 'PUBLIC CONFIG VERIFIED. News queries will use the live Worker.'
else
  echo 'WARNING: Hosting deployed but live CDN config did not yet verify. Clear browser cache and check again.' >&2
fi
if command -v open >/dev/null 2>&1;then open "$SITE/?nw=080" >/dev/null 2>&1 || true;fi