#!/bin/bash
# Narrative Wave v0.4 — standalone-click-to-investigate Mac update.
# Existing SQLite data, previous investigations and legacy case ledger are preserved.
set -euo pipefail
APP="$HOME/Applications/Narrative-Wave"
if [[ ! -f "$APP/standalone/app.py" || ! -f "$APP/standalone/index.html" || ! -f "$APP/START-NARRATIVE-WAVE.command" ]]; then
  printf 'ERROR: Existing standalone Narrative Wave app was not found at %s. Nothing changed.\n' "$APP" >&2
  exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo 'ERROR: Python 3 is required. No files changed.' >&2
  exit 1
fi
PYTHON="$(command -v python3)"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/nw-desk-v04.XXXXXXXX")"
cleanup(){ rm -rf "$WORK"; }
trap cleanup EXIT
"$PYTHON" - "$WORK" <<'NW_ASSETS'
