E+Y2IMztRXBO4NpAwLUXF2sRSAq3YbB4vpoXBQSQAFN7zAsLEhH45RhU33HkC4pXAO+LUsSCi8JFqBkwf/geJEHQ7Nx+pO9rhAgeDLPa
Nmgwt9ugCaof91sSCm5IoWFZAqxSh183OmTxj1Bikm4dZSI7CdoX7Uis5EDn1c1wwymlPfMlsMAs5f2Ptc2HWReloS8TDh28367FboRX
IIlhgTqsqb1zM7CmbaL2UTJDdoc6NbNj6Ng9KiQKGMiEgJH9ZhxxywFWUM+LevhWpqUo6x6AvwOVv0BkUVS2cJb7EHkHEX94+Y/XqEdP
ppgYlWg4S2eNH5+cWdn81I06qMF4r16+Piuln7K6bZ8VmFNGq8Ua4remEihLmp6kzoYKX6FvGeR4ms337yuNeq2j+A4jpHdFSK9ciFWp
SlWqUpWqVKUqValKVapSlapUpSpVqUpVqlKVqlSlKlWpSlWqUpWqVKUqValKVf5H5T/P4ancAJABAA=='''
compressed=base64.b64decode(''.join(payload.split()),validate=True)
if hashlib.sha256(compressed).hexdigest()!='1d5cdb5df06939d4fbf43a4c7b242c181f552645de3c3bb3d99c3a27dcd5eb1b':
    raise SystemExit('ERROR: Release integrity verification failed; nothing changed')
allowed={'site/favicon.svg', 'worker/test/worker.test.mjs', 'worker/wrangler.jsonc', 'site/README-BACKEND.md', 'worker/worker.js', 'site/index.html', 'site/legal.html', 'site/spark.css', 'worker/package.json', 'site/spark.js', 'site/pyrinas-wordmark.svg'}
dest=Path(sys.argv[1])
with tarfile.open(fileobj=io.BytesIO(gzip.decompress(compressed)),mode='r:') as ar:
    items=ar.getmembers()
    if {m.name for m in items}!=allowed:raise SystemExit('Unexpected release contents')
    for m in items:
        if not m.isfile() or m.size>250000:raise SystemExit('Invalid release file type or size')
        path=dest/m.name;path.parent.mkdir(parents=True,exist_ok=True)
        path.write_bytes(ar.extractfile(m).read())
print('Narrative Wave 0.7 release integrity: VERIFIED')
NW_EXTRACT

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [[ "$NODE_MAJOR" != 22 && "$NODE_MAJOR" != 24 ]]; then
  if command -v brew >/dev/null 2>&1; then
    PREFIX="$(brew --prefix node@22 2>/dev/null || true)"
    if [[ -x "$PREFIX/bin/node" ]]; then export PATH="$PREFIX/bin:$PATH";fi
  fi
  NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
fi
if [[ "$NODE_MAJOR" != 22 && "$NODE_MAJOR" != 24 ]];then
  echo 'ERROR: This deployment needs existing Node.js 22 or 24. Your local Node 22 was previously working.' >&2
  exit 1
fi
printf '\nRunning the actual news gateway tests with Node %s...\n' "$(node --version)"
(cd "$TEMP_DIR/worker" && node --test)
node --check "$TEMP_DIR/site/spark.js"
if [[ "$MODE" == "--dry-run" ]];then
  echo 'DRY RUN COMPLETE: App and gateway tests passed; no account actions, deployments or website changes.'
  exit 0
fi
if [[ ! -t 0 ]];then
  echo 'ERROR: Run the downloaded script as a file in Terminal. Do not use curl | bash for account authorization.' >&2
  exit 2
fi
FB="$ROOT/.tools/node_modules/.bin/firebase"
if [[ ! -x "$FB" ]];then
  echo 'ERROR: The existing private Firebase CLI was not found. No projects changed.' >&2
  exit 1
fi
if ! "$FB" login:list 2>&1 | grep -Fq "$ACCOUNT";then
  echo "ERROR: Firebase CLI is not logged in as $ACCOUNT. No projects changed." >&2
  exit 1
fi
if ! command -v npm >/dev/null 2>&1;then echo 'ERROR: npm not found.' >&2;exit 1;fi

mkdir -p "$WORKER_DIR" "$TOOLS_DIR"
cp -R "$TEMP_DIR/worker/." "$WORKER_DIR/"
printf '%s\n' 'NARRATIVE_WAVE_NEWS_GATEWAY_V07' > "$WORKER_DIR/.narrative-wave-news-v07"
WRANGLER="${NARRATIVE_WAVE_WRANGLER_BIN:-$TOOLS_DIR/node_modules/.bin/wrangler}"
if [[ ! -x "$WRANGLER" ]];then
  printf '\nInstalling Wrangler into Narrative Wave only (not globally)...\n'
  npm install --no-audit --no-fund --prefix "$TOOLS_DIR" 'wrangler@^4.119.0'
fi
printf 'Cloudflare Wrangler: %s\n' "$("$WRANGLER" --version | tail -n 1)"
if ! "$WRANGLER" whoami > "$TEMP_DIR/whoami.txt" 2>&1 || grep -Eiq 'not (logged in|authenticated)|unauthorized' "$TEMP_DIR/whoami.txt";then
  printf '\nCloudflare sign-in is required ONE TIME for the no-cost Workers backend.\n'
  printf 'A browser opens for device authorization. Approve access to your Cloudflare account.\n'
  "$WRANGLER" login --device < /dev/tty
fi
if ! "$WRANGLER" whoami >/dev/null 2>&1;then
  echo 'ERROR: Cloudflare access was not confirmed. Firebase site remains unchanged.' >&2;exit 2
fi

printf '\nDeploying the news gateway to Cloudflare Workers...\n'
(cd "$WORKER_DIR" && "$WRANGLER" deploy --config "$WORKER_DIR/wrangler.jsonc" < /dev/tty) 2>&1 | tee "$TEMP_DIR/wrangler-deploy.log"
WORKER_URL="$(python3 - "$TEMP_DIR/wrangler-deploy.log" <<'NW_URL'
import re,sys
text=open(sys.argv[1]).read();u=re.findall(r'https://[a-z0-9-]+\.[a-z0-9.-]+\.workers\.dev',text,re.I)
u=[x.rstrip('/') for x in u if x.split('://',1)[1].split('.')[0]=='narrative-wave-news-tgot']
print(u[-1] if u else '')
NW_URL
)"
if [[ ! "$WORKER_URL" =~ ^https://narrative-wave-news-tgot\.[a-z0-9.-]+\.workers\.dev$ ]];then
  echo 'ERROR: Wrangler did not confirm a workers.dev URL for Narrative Wave. Firebase site unchanged.' >&2;exit 2
fi
printf 'News gateway: %s\n' "$WORKER_URL"

printf '\nChecking the ACTUAL deployed backend, not mock news data...\n'
if ! curl -fsSL --max-time 25 -H "Origin: https://$PROJECT.web.app" "$WORKER_URL/health" -o "$TEMP_DIR/health.json";then
  echo 'ERROR: Deployed news gateway health check failed. The Firebase site is unchanged.' >&2;exit 2
fi
if ! python3 - "$TEMP_DIR/health.json" <<'NW_HEALTH'
import json,sys
try:
 d=json.load(open(sys.argv[1]));assert d.get('status')=='ok' and d.get('service')=='narrative-wave-news-gateway'
 print('Live gateway health: OK')
except Exception as e:
 print('ERROR: News gateway health returned invalid data:',e,file=sys.stderr);sys.exit(1)
NW_HEALTH
then exit 2;fi

FEED_OK=0
for QUERY in Detroit hackers; do
  printf 'Live news search: %s (last 30 days)...\n' "$QUERY"
  if curl -sS -G --max-time 90 -H "Origin: https://$PROJECT.web.app" \
    --data-urlencode "q=$QUERY" --data-urlencode 'range=30d' \
    "$WORKER_URL/news" -o "$TEMP_DIR/live-news.json";then
    if python3 - "$TEMP_DIR/live-news.json" <<'NW_CHECK_LIVE'
import json,sys
try:
  j=json.load(open(sys.argv[1])); a=j.get('articles',[])
  print('Provider:',j.get('provider') or 'unavailable','| Status:',j.get('status'),'| Real indexed records:',len(a))
  if not a:print('Upstream diagnostics:', ' | '.join(j.get('warnings') or []))
  assert j.get('status')=='ok' and isinstance(a,list) and len(a)>0
except Exception as e:
  print('Live news verification failed:',str(e),file=sys.stderr);sys.exit(1)
NW_CHECK_LIVE
    then FEED_OK=1;break;fi
  else echo "Gateway request failed for $QUERY";fi
done
if [[ "$FEED_OK" -ne 1 ]];then
  printf '\nERROR: The public gateway did NOT retrieve any live headlines.\n'
  printf 'I will NOT replace your Firebase website with another unverified feed.\n'
  printf 'Cloudflare gateway (health only): %s\n' "$WORKER_URL"
  printf 'Cloudflare source diagnostics are shown above. The current Firebase site was not modified.\n'
  exit 3
fi

printf '\nNews retrieval VERIFIED from the public Worker. Preparing Firebase Hosting update...\n'
BACKUP="$ROOT/.nw-site-backups/$(date '+%Y%m%d-%H%M%S')"
mkdir -p "$BACKUP"
cp -R "$ROOT/public" "$BACKUP/public"
cp "$ROOT/firebase.spark.json" "$BACKUP/firebase.spark.json"
rollback_on_error(){
  rc=$?
  if [[ "$rc" -ne 0 && -f "$BACKUP/public/index.html" ]];then
    rm -rf "$ROOT/public"
    cp -R "$BACKUP/public" "$ROOT/public"
    printf 'Local Firebase website files restored from backup after failure.\n' >&2
  fi
}
trap rollback_on_error EXIT
for file in index.html spark.js spark.css legal.html favicon.svg pyrinas-wordmark.svg;do
  cp "$TEMP_DIR/site/$file" "$ROOT/public/$file"
done
cp "$TEMP_DIR/site/README-BACKEND.md" "$ROOT/README-BACKEND.md"
python3 - "$ROOT/public/worker-config.js" "$WORKER_URL" <<'NW_CONFIG'
import json,sys
path,url=sys.argv[1:]
open(path,'w').write('/* Public URL for the dedicated Narrative Wave news gateway. No secret token. */\nwindow.NARRATIVE_WAVE_NEWS_API='+json.dumps(url)+';\n')
NW_CONFIG
node --check "$ROOT/public/spark.js"
(cd "$ROOT" && "$FB" --account "$ACCOUNT" deploy --only hosting --config firebase.spark.json --project "$PROJECT" --non-interactive)
trap cleanup EXIT
printf '\nNARRATIVE WAVE NEWS GATEWAY IS LIVE\n'
printf 'Public site: https://%s.web.app\nBackend: %s\n' "$PROJECT" "$WORKER_URL"
printf 'Account: %s | Firebase plan: Spark | Functions: NONE\n' "$ACCOUNT"
printf 'Previous public files: %s\n' "$BACKUP"
printf 'Other Firebase projects and existing local research database: UNCHANGED\n'
if curl -fsSL --max-time 15 "https://$PROJECT.web.app/worker-config.js?v=070" -o "$TEMP_DIR/served-config.js" && \
   grep -Fq "$WORKER_URL" "$TEMP_DIR/served-config.js";then
  echo 'Firebase Hosting confirmed the browser can load the correct Worker URL.'
else
  echo 'WARNING: Firebase deploy succeeded, but CDN config could not yet be independently verified. Wait 1 minute and refresh.' >&2
fi
if command -v open >/dev/null 2>&1;then open "https://$PROJECT.web.app/?nw=070" >/dev/null 2>&1 || true;fi