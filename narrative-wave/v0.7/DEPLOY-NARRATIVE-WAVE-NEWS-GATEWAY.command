#!/usr/bin/env bash
# Narrative Wave v0.7 - Spark website + Cloudflare Workers FREE server-side news gateway.
# No Firebase Cloud Functions, Blaze billing, plugin, or other project changes.
# The public website is NOT replaced until the live Worker returns real news headlines.
set -euo pipefail

PROJECT="narrative-wave-tgot-b64ad8"
ACCOUNT="tim@pyrinas.co"
ROOT="${NARRATIVE_WAVE_PUBLIC_ROOT:-$HOME/Applications/Narrative-Wave/public-web}"
WORKER_DIR="$ROOT/.nw-news-gateway-v07"
TOOLS_DIR="$ROOT/.nw-news-tools"
MODE="${1:-deploy}"
if [[ "$MODE" != "deploy" && "$MODE" != "--dry-run" ]]; then
  echo 'Usage: bash deployment.command [--dry-run]' >&2; exit 2
fi
if [[ ! -f "$ROOT/public/index.html" || ! -f "$ROOT/firebase.spark.json" || ! -f "$ROOT/.nw-project-id" ]]; then
  printf 'ERROR: Existing public Narrative Wave Spark installation not found at %s\n' "$ROOT" >&2;exit 1
fi
if [[ "$(tr -d '\r\n' < "$ROOT/.nw-project-id")" != "$PROJECT" ]]; then
  echo 'ERROR: This folder is not assigned to the dedicated Narrative Wave Firebase project. Nothing changed.' >&2;exit 1
fi
if ! command -v python3 >/dev/null 2>&1; then echo 'ERROR: Python 3 required.' >&2;exit 1;fi
if ! python3 - "$ROOT/firebase.spark.json" "$PROJECT" <<'NW_CHECK_FIREBASE_JSON'
import json,sys
try:
    cfg=json.load(open(sys.argv[1])); host=cfg['hosting'];site=host.get('site','')
    assert site==sys.argv[2],f'Hosting site {site!r} is not the expected Narrative Wave site'
    assert host.get('public')=='public','Unexpected Hosting public directory'
except (OSError,ValueError,KeyError,AssertionError) as e:
    print('ERROR: Firebase hosting config safety check failed:',e,file=sys.stderr);sys.exit(1)
NW_CHECK_FIREBASE_JSON
then exit 1; fi
if [[ -e "$WORKER_DIR" && ! -f "$WORKER_DIR/.narrative-wave-news-v07" ]]; then
  echo 'ERROR: Worker folder contains unknown files; refusing to overwrite it.' >&2;exit 1
fi
TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/narrative-wave-news-v07.XXXXXXXX")"
cleanup(){ rm -rf "$TEMP_DIR"; }
trap cleanup EXIT

# Verified self-contained project payload. No unreliable Downloads path or ZIP to find.
python3 - "$TEMP_DIR" <<'NW_EXTRACT'
